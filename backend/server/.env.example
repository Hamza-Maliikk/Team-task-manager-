PORT=5000
NODE_ENV=development
# Neon / Supabase / Cloud SQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Frontend origin for CORS (dev only; in production the same origin serves everything)
CLIENT_ORIGIN=http://localhost:5173
# Set to "memory" to keep sessions in memory (dev fallback)
# SESSION_STORE=memory
